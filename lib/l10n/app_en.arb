{
  "@@locale": "en",
  "appName": "FlutterBase",
  "@appName":{
    "description": "Application title",
    "type": "text"
  },
    "timeoutError": "Превышено время ожидания ответа от сервера.",
  "@timeoutError": {
    "description": "Сообщение об ошибке таймаута",
    "type": "text"
  },
  "socketError": "Не удалось установить соединение. Проверьте подключение к сети интернет.",
  "@socketError": {
    "description": "Ошибка говорит о наличие проблем во время установления соединения"
  },
    "unknownError": "Произошла неизвестная ошибка.",
  "@unknownError": {
    "description": "Сообщение об неизвестной ошибке",
    "type": "text"
  },
  "validationError": "Ошибка валидации данных.",
  "@validationError": {
    "description": "Сообщение об ошибке валидации",
    "type": "text"
  },
    "stateError": "Некорректное внутренние состояние программы.",
  "@stateError": {
    "description": "Сообщение об некорректном внутреннем состояние программы"
  },
    "serverError": "Ошибка сервера. Пожалуйста, попробуйте позже.",
  "@serverError": {
    "description": "Сообщение об ошибке сервера",
    "type": "text"
  },
  "authenticationError": "Ошибка аутентификации. Пожалуйста, войдите снова.",
  "@authenticationError": {
    "description": "Сообщение об ошибке аутентификации",
    "type": "text"
  },
  "apiError": "Ошибка при выполнении запроса (код: {statusCode}).",
  "@apiError": {
    "description": "Сообщение об ошибке API с параметром кода статуса",
    "type": "text",
    "placeholders": {
      "statusCode": {}
    }
  },
  "socketConnectionError": "Для этого действия требуется интернет соединение. Включите или проверьте текущие.",
  "@socketConnectionError": {
    "description": "Сообщение об ошибке отсутствия интернет соединения",
    "type": "text"
  }
}